<?xml version="1.0" encoding="utf-8"?>
<!--
  Avant status-bar notification icon.
  Android requires small icons to be white-on-transparent monochrome.
  This vector reproduces the Avant elevator emblem:
    - Outer circle ring
    - Up-pointing triangle (lift going up)
    - Down-pointing triangle (lift going down)
    - Horizontal-stripe panel (elevator door / display)

  24×24dp @ 1x; scales cleanly across all densities.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Outer circle ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.4"
        android:pathData="M12,1.5 A10.5,10.5 0 1 1 11.99,1.5 Z" />

    <!-- Up-pointing triangle (top half) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,4.0 L8.5,9.0 L15.5,9.0 Z" />

    <!-- Down-pointing triangle (bottom half) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,20.0 L8.5,15.0 L15.5,15.0 Z" />

    <!-- Horizontal stripe panel (right side — elevator display) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M14.5,9.8 L18.5,9.8 L18.5,10.6 L14.5,10.6 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M14.5,11.2 L18.5,11.2 L18.5,12.0 L14.5,12.0 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M14.5,12.6 L18.5,12.6 L18.5,13.4 L14.5,13.4 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M14.5,14.0 L18.5,14.0 L18.5,14.2 L14.5,14.2 Z" />

</vector>
