# Port this relay listens on. Put a reverse proxy (Caddy/nginx) in front of
# it for TLS — browsers require wss:// (not ws://) from an https:// page.
PORT=8082

# Shared secrets the device app and the admin's Configurations tab must send
# when they connect, so a stranger who finds this port can't register as a
# fake device or eavesdrop as a fake admin. Generate two long random strings,
# e.g.: openssl rand -hex 32
DEVICE_SECRET=change-me-device-secret
ADMIN_SECRET=change-me-admin-secret
