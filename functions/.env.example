# Copy this file to functions/.env and fill in your actual values
# NEVER commit the actual .env file — it is gitignored

# Zoho Email (SMTP)
ZOHO_EMAIL=your@company.zoho.in
ZOHO_APP_PASSWORD=your_zoho_app_password
ZOHO_SMTP_HOST=smtp.zoho.in

# SMS disabled — all Indian SMS providers require DLT registration (TRAI mandate)
# OTP is sent via email only. Add SMS provider here when DLT is ready.
