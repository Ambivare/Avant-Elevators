rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    // ─── users ────────────────────────────────────────────────────────────────
    match /users/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── employees ────────────────────────────────────────────────────────────
    match /employees/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── inventory ────────────────────────────────────────────────────────────
    match /inventory/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── projects ─────────────────────────────────────────────────────────────
    // NOTE: All sessions (staff AND public QR scanners) use anonymous Firebase
    // auth, so rules cannot distinguish them at token level. The public QR page
    // (LiftTicketView) is restricted at code level to a single-doc getOne() call
    // — it never lists the collection.
    match /projects/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── projectTimeline ──────────────────────────────────────────────────────
    match /projectTimeline/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── maintenance ──────────────────────────────────────────────────────────
    match /maintenance/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── amc ──────────────────────────────────────────────────────────────────
    match /amc/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── amcMonthlyMaintenance ────────────────────────────────────────────────
    match /amcMonthlyMaintenance/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── activities ───────────────────────────────────────────────────────────
    match /activities/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── leads ────────────────────────────────────────────────────────────────
    match /leads/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── tasks ────────────────────────────────────────────────────────────────
    match /tasks/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── invoices ─────────────────────────────────────────────────────────────
    match /invoices/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── installationActivities ───────────────────────────────────────────────
    match /installationActivities/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── modernisationActivities ──────────────────────────────────────────────
    match /modernisationActivities/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── repairActivities ─────────────────────────────────────────────────────
    match /repairActivities/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── complaintActivities ──────────────────────────────────────────────────
    match /complaintActivities/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── salarySlips ──────────────────────────────────────────────────────────
    match /salarySlips/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── salaryConfig ─────────────────────────────────────────────────────────
    match /salaryConfig/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── quotations ───────────────────────────────────────────────────────────
    match /quotations/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── purchaseOrders ───────────────────────────────────────────────────────
    match /purchaseOrders/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── proformaInvoices ─────────────────────────────────────────────────────
    match /proformaInvoices/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── taxInvoices ──────────────────────────────────────────────────────────
    match /taxInvoices/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── vendors ──────────────────────────────────────────────────────────────
    match /vendors/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── materials ────────────────────────────────────────────────────────────
    match /materials/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── bom ──────────────────────────────────────────────────────────────────
    match /bom/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── settings ─────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── configurations ───────────────────────────────────────────────────────
    match /configurations/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── leaveRequests ────────────────────────────────────────────────────────
    match /leaveRequests/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── gallery ──────────────────────────────────────────────────────────────
    match /gallery/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── galleryFolders ───────────────────────────────────────────────────────
    match /galleryFolders/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── inspections ──────────────────────────────────────────────────────────
    match /inspections/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── pdfCache ─────────────────────────────────────────────────────────────
    match /pdfCache/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── fcmTokens ────────────────────────────────────────────────────────────
    match /fcmTokens/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── attendance ───────────────────────────────────────────────────────────
    match /attendance/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── technicianLocations ──────────────────────────────────────────────────
    match /technicianLocations/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── siteVisitEvents ──────────────────────────────────────────────────────
    match /siteVisitEvents/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── trackingSessions ─────────────────────────────────────────────────────
    match /trackingSessions/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── locationHistory ──────────────────────────────────────────────────────
    match /locationHistory/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── checklistItems ───────────────────────────────────────────────────────
    match /checklistItems/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── inventoryUsage ───────────────────────────────────────────────────────
    match /inventoryUsage/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── tickets ──────────────────────────────────────────────────────────────
    match /tickets/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── appBackups (Settings → Backup/Restore) ──────────────────────────────
    // Metadata doc at appBackups/{backupId}, plus one subcollection per backed-up
    // collection at appBackups/{backupId}/{collectionName}/{docId}.
    match /appBackups/{backupId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();

      match /{collectionName}/{docId} {
        allow read:   if isAuth();
        allow create: if isAuth();
        allow update: if isAuth();
        allow delete: if isAuth();
      }
    }

    // ─── liftCertificates ─────────────────────────────────────────────────────
    match /liftCertificates/{docId} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ─── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

